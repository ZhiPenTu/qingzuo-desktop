{
  "name": "qingzuo-desktop",
  "private": true,
  "version": "0.6.12",
  "main": "desktop/main.mjs",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:desktop": "npm run build && node scripts/prepare-platform.mjs && node scripts/package-desktop.mjs",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:start": "electron .",
    "platform:prepare": "node scripts/prepare-platform.mjs",
    "plugin": "node packages/plugin-sdk/cli.mjs",
    "test": "vitest run",
    "test:platform": "node --test tests/platform/*.test.mjs",
    "test:sandbox": "node --test tests/platform/sandbox.test.mjs",
    "test:kernel": "node --test tests/platform/kernel.test.mjs",
    "build:sandbox": "cargo build --release --manifest-path native/sandbox/Cargo.toml",
    "test:desktop": "playwright test --config tests/electron/playwright.config.mjs",
    "build:harness-native": "node scripts/build-harness-native.mjs",
    "test:harness-contract": "node --test tests/platform/ai-chat.test.mjs tests/platform/ai.test.mjs tests/platform/ai-harness-adapter.test.mjs tests/platform/harness-session-compatibility.test.mjs tests/platform/harness-pending-session.test.mjs && vitest run src/platform/AIChat.test.tsx",
    "upstream:check": "node scripts/harness-upstream.mjs check",
    "upstream:harness": "node scripts/harness-upstream.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@commerce/platform-bundle": "file:packages/platform-bundle",
    "@commerce/plugin-sdk": "file:packages/plugin-sdk",
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-jobs-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@shikijs/langs": "4.3.1",
    "adm-zip": "0.5.16",
    "anser": "2.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron-updater": "6.8.9",
    "immer": "10.1.1",
    "lucide-react": "^0.468.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "semver": "7.8.5",
    "shiki": "4.3.1",
    "simple-icons": "^16.31.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "node-addon-api": "8.9.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "overrides": {
    "node-addon-require-builtin": "0.1.9"
  }
}
